# Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Prisma / PostgreSQL / MySQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlm_db?schema=public"

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis Configuration (Bull Queues & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Base URL (for email links)
FRONTEND_URL=http://localhost:5173

# Email / SMTP Configuration (Production Email Integration)
# Option 1: Gmail Service (Recommended for quick testing & production)
# SMTP_SERVICE=gmail
# SMTP_USER=yourbrand@gmail.com
# SMTP_PASS=your-16-digit-app-password

# Option 2: Standard Production SMTP (AWS SES, SendGrid, Mailgun, SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourbrand@gmail.com
SMTP_PASS=your-16-digit-app-password
EMAIL_FROM_NAME="AAKASH E-COM Notifications"
EMAIL_FROM_ADDRESS=no-reply@aakashecom.com
