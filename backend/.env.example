# Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Prisma / PostgreSQL / MySQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlm_db?schema=public"

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis Configuration (Bull Queues & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
