# Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Prisma / PostgreSQL / MySQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlm_db?schema=public"

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis Configuration (Bull Queues & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Base URL (for email links)
FRONTEND_URL=http://localhost:5173

# Email / Resend SMTP Configuration
# ----------------------------------------------------
# Sign up at https://resend.com and create an API Key (starts with re_)
# For initial dev testing without custom domain, use EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Once domain is verified in Resend, set EMAIL_FROM_ADDRESS=noreply@yourdomain.com

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_YourResendApiKeyHere
EMAIL_FROM_NAME="AAKASH E-COM"
EMAIL_FROM_ADDRESS=onboarding@resend.dev

