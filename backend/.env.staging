# Application Config
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1

# Database Configuration
DATABASE_URL="postgresql://postgres:staging_pass@staging-db.internal:5432/mlm_db_staging?schema=public"

# JWT Authentication
JWT_SECRET=staging-jwt-secret-key-67890
JWT_EXPIRES_IN=3d

# Redis Configuration
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=https://staging.aakashecom.com
