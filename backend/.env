# Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Prisma / PostgreSQL / MySQL)
DATABASE_URL="postgresql://postgres:2453@localhost:5432/mlm_db?schema=public"

# JWT Authentication
JWT_SECRET=dev-jwt-secret-key-12345
JWT_EXPIRES_IN=7d

# Redis Configuration (Bull Queues & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Base URL (for email reset links)
FRONTEND_URL=http://localhost:5173

