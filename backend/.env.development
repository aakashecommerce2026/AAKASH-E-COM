# Application Config
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlm_db_dev?schema=public"

# JWT Authentication
JWT_SECRET=dev-jwt-secret-key-12345
JWT_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
