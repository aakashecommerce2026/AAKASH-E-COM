{
	"info": {
		"_postman_id": "aakash-mlm-auth-collection-v1",
		"name": "AAKASH MLM - Authentication & Admin Member Management API",
		"description": "Postman Collection for AAKASH E-COM MLM Backend Service authentication, token rotation, password management, role-protected member endpoints, and Admin Member Management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    pm.environment.set('refreshToken', jsonData.refreshToken);",
									"    pm.environment.set('adminId', jsonData.user.id);",
									"    console.log('Tokens updated successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"ADM-0001\",\n  \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticate Admin user using memberCode ADM-0001 and password Admin@123"
					},
					"response": []
				},
				{
					"name": "2. Member Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set('memberAccessToken', jsonData.accessToken);",
									"    pm.environment.set('memberRefreshToken', jsonData.refreshToken);",
									"    pm.environment.set('memberId', jsonData.user.id);",
									"    console.log('Member tokens updated');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"AK10001\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticate standard Member user"
					},
					"response": []
				},
				{
					"name": "3. Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    pm.environment.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						},
						"description": "Rotate 15-minute access token using valid 7-day refresh token"
					},
					"response": []
				},
				{
					"name": "4. Change Password",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewSecureP@ss123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/change-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"change-password"
							]
						},
						"description": "Change password for logged-in user"
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Member Management",
			"item": [
				{
					"name": "1. POST /admin/members (Create Member)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Smith\",\n  \"mobile\": \"+919876543211\",\n  \"email\": \"alice@example.com\",\n  \"address\": \"456 Commerce Ave\",\n  \"role\": \"MEMBER\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/members",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members"
							]
						},
						"description": "Create member by Admin. Auto-generates memberCode and temp password if omitted."
					},
					"response": []
				},
				{
					"name": "2. GET /admin/members (Paginated List & Search)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/members?page=1&limit=10&search=Alice&status=ACTIVE",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "search",
									"value": "Alice"
								},
								{
									"key": "status",
									"value": "ACTIVE"
								}
							]
						},
						"description": "Get paginated members list with name/mobile/email/member_code search and status filter."
					},
					"response": []
				},
				{
					"name": "3. GET /admin/members/:id (Single Member + Populated Referrer)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/members/{{memberId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members",
								"{{memberId}}"
							]
						},
						"description": "View single member details with populated referrer info."
					},
					"response": []
				},
				{
					"name": "4. PUT /admin/members/:id (Edit Member)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Smith Updated\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/members/{{memberId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members",
								"{{memberId}}"
							]
						},
						"description": "Edit member details."
					},
					"response": []
				},
				{
					"name": "5. GET /admin/members/:id/referrer (Referrer Info)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/members/{{memberId}}/referrer",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members",
								"{{memberId}}",
								"referrer"
							]
						},
						"description": "Quick admin lookup for direct referrer information."
					},
					"response": []
				},
				{
					"name": "6. GET /admin/members/:id/downline-preview (1-Level Downline)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/members/{{memberId}}/downline-preview",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"admin",
								"members",
								"{{memberId}}",
								"downline-preview"
							]
						},
						"description": "Shallow (1-level) downline preview listing direct referrals."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "memberId",
			"value": "",
			"type": "string"
		}
	]
}
