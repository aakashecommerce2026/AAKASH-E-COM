// Prisma Schema for AAKASH MLM Application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Member Access Roles
enum MemberRole {
  ADMIN
  SUB_ADMIN
  MEMBER
  SUPPORT
}

/// Member Account Lifecycle Status
enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

/// Commission Status
enum CommissionStatus {
  PENDING
  CALCULATED
  DISBURSED
  CANCELLED
  HOLD
}

/// Members Table: Stores user profile, authentication, sponsor relationship, and payout details
model Member {
  id         String  @id @default(uuid())
  memberCode String  @unique @map("member_code")
  name       String
  mobile     String  @unique
  email      String? @unique
  address    String? @db.Text

  // Self-referential relationship for Sponsor / Referrer downline tree
  referrerId String?  @map("referrer_id")
  referrer   Member?  @relation("MemberReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals  Member[] @relation("MemberReferrals")

  joiningDate  DateTime     @default(now()) @map("joining_date")
  upiId        String?      @map("upi_id")
  bankDetails  Json?        @map("bank_details")
  status       MemberStatus @default(ACTIVE)
  passwordHash String       @map("password_hash")
  role         MemberRole   @default(MEMBER)

  // Reverse relations for RepurchaseEntry
  repurchases        RepurchaseEntry[] @relation("MemberRepurchases")
  createdRepurchases RepurchaseEntry[] @relation("RepurchasesCreatedBy")

  // Reverse relations for MembershipCommissionLedger
  membershipCommissionsSourced MembershipCommissionLedger[] @relation("MembershipCommissionSource")
  membershipCommissionsEarned  MembershipCommissionLedger[] @relation("MembershipCommissionBeneficiary")

  // Reverse relations for RepurchaseCommissionLedger
  repurchaseCommissionsSourced RepurchaseCommissionLedger[] @relation("RepurchaseCommissionSource")
  repurchaseCommissionsEarned  RepurchaseCommissionLedger[] @relation("RepurchaseCommissionBeneficiary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerId])
  @@index([memberCode])
  @@index([mobile])
  @@index([status])
  @@index([joiningDate])
  @@map("members")
}

/// Repurchase Entries Table: Tracks repurchase transactions for members
model RepurchaseEntry {
  id             String @id @default(uuid())
  transactionRef String @unique @map("transaction_ref")
  memberId       String @map("member_id")
  member         Member @relation("MemberRepurchases", fields: [memberId], references: [id], onDelete: Cascade)

  amount          Decimal  @db.Decimal(12, 2)
  transactionDate DateTime @default(now()) @map("transaction_date")
  remarks         String?  @db.Text

  createdBy String? @map("created_by")
  creator   Member? @relation("RepurchasesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  // Reverse relation for RepurchaseCommissionLedger
  commissionLedgers RepurchaseCommissionLedger[] @relation("RepurchaseCommissions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([transactionRef])
  @@index([transactionDate])
  @@index([createdBy])
  @@map("repurchase_entries")
}

/// Membership Commission Ledger Table: Tracks commission calculation and disbursements from membership registrations
model MembershipCommissionLedger {
  id String @id @default(uuid())

  sourceMemberId String @map("source_member_id")
  sourceMember   Member @relation("MembershipCommissionSource", fields: [sourceMemberId], references: [id], onDelete: Cascade)

  beneficiaryMemberId String @map("beneficiary_member_id")
  beneficiaryMember   Member @relation("MembershipCommissionBeneficiary", fields: [beneficiaryMemberId], references: [id], onDelete: Cascade)

  level      Int
  percentage Decimal          @db.Decimal(5, 2)
  amount     Decimal          @db.Decimal(12, 2)
  status     CommissionStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourceMemberId])
  @@index([beneficiaryMemberId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("membership_commission_ledger")
}

/// Repurchase Commission Ledger Table: Tracks commission calculations and disbursements from repurchase transactions
model RepurchaseCommissionLedger {
  id String @id @default(uuid())

  repurchaseEntryId String          @map("repurchase_entry_id")
  repurchaseEntry   RepurchaseEntry @relation("RepurchaseCommissions", fields: [repurchaseEntryId], references: [id], onDelete: Cascade)

  sourceMemberId String @map("source_member_id")
  sourceMember   Member @relation("RepurchaseCommissionSource", fields: [sourceMemberId], references: [id], onDelete: Cascade)

  beneficiaryMemberId String @map("beneficiary_member_id")
  beneficiaryMember   Member @relation("RepurchaseCommissionBeneficiary", fields: [beneficiaryMemberId], references: [id], onDelete: Cascade)

  level      Int
  percentage Decimal          @db.Decimal(5, 2)
  amount     Decimal          @db.Decimal(12, 2)
  status     CommissionStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([repurchaseEntryId, beneficiaryMemberId, level])
  @@index([repurchaseEntryId])
  @@index([sourceMemberId])
  @@index([beneficiaryMemberId])
  @@index([status])
  @@index([level])
  @@index([createdAt])
  @@map("repurchase_commission_ledger")
}
