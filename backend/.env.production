# Application Config
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database Configuration
DATABASE_URL="postgresql://prod_user:prod_pass@prod-db.internal:5432/mlm_db_prod?schema=public"

# JWT Authentication
JWT_SECRET=production-jwt-secret-key-change-me
JWT_EXPIRES_IN=1d

# Redis Configuration
REDIS_HOST=prod-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=https://aakashecom.com
